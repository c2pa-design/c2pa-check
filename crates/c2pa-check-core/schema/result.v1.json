{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2pa.design/schema/result.v1.json",
  "title": "Normalized provenance result, schema v1",
  "description": "One document produced identically by the browser analyzer, the c2pa-check CLI, the provenance engine and the c2pa.design API.",
  "type": "object",
  "required": ["schema_version", "engine", "credential", "source", "validation", "asset"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "engine": {
      "type": "object",
      "required": ["name", "version", "trust_list_version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "trust_list_version": { "type": "string" }
      }
    },
    "credential": {
      "type": "object",
      "required": ["present", "valid", "trusted", "status"],
      "properties": {
        "present": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "trusted": { "type": "boolean" },
        "status": { "$ref": "#/$defs/credentialStatus" }
      }
    },
    "signer": {
      "type": "object",
      "properties": {
        "organization": { "type": "string" },
        "common_name": { "type": "string" },
        "issuer": { "type": "string" },
        "cert_serial": { "type": "string" },
        "on_trust_list": { "enum": ["official", "interim", "none"] },
        "conformant_product": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "assurance_level": { "enum": ["L1", "L2"] }
          }
        },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_to": { "type": "string", "format": "date-time" }
      }
    },
    "claim": {
      "type": "object",
      "properties": {
        "generator": { "type": "string" },
        "spec_version": { "type": "string" },
        "signed_at": { "type": "string" },
        "timestamp_authority": { "type": "string" },
        "algorithm": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "digital_source_type": { "type": "string" },
        "category": { "$ref": "#/$defs/sourceCategory" }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "when": { "type": "string" },
          "software": { "type": "string" }
        }
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "relationship": { "type": "string" },
          "credential_status": { "$ref": "#/$defs/credentialStatus" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "$ref": "#/$defs/validationEntries" },
        "warnings": { "$ref": "#/$defs/validationEntries" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["sha256", "mime_type", "size_bytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mime_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "pdq": {
          "description": "256-bit PDQ perceptual hash of the decoded raster (JPEG, PNG, WebP, GIF; AVIF and HEIC where the engine decodes them), alpha-composited onto white, as 64 lowercase hex characters. For an animated image, the first kept frame. Absent when the image could not be decoded or is not a raster.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdq_quality": {
          "description": "PDQ quality metric. Below 50 the hash is unreliable for matching.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pdq_black": {
          "description": "PDQ of the image alpha-composited onto black. Present only when a pixel is not fully opaque.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdq_mirrors": {
          "description": "PDQ of the horizontal and the vertical mirror, derived from the same DCT. Used to probe for mirrored copies.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "pdq_frames": {
          "description": "Animated images only: PDQ of up to 16 kept frames (about one per second of frame time, near-duplicates and frames below quality 50 dropped).",
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "metadata": {
      "description": "Embedded IPTC/Exif/XMP metadata presence, scored as IPTC Metawatch does. Present for every image media type.",
      "type": "object",
      "required": ["four_cs_score", "fields", "digital_source_type", "ai_system_used"],
      "properties": {
        "four_cs_score": {
          "description": "25 each for Creator, Copyright, CaptionDescription and CreditLine.",
          "type": "integer",
          "enum": [0, 25, 50, 75, 100]
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/metawatchField" }
        },
        "digital_source_type": {
          "description": "Last path segment of Iptc4xmpExt:DigitalSourceType from XMP.",
          "type": ["string", "null"]
        },
        "ai_system_used": { "type": ["string", "null"] }
      }
    },
    "raw_manifest_store": { "type": "object" }
  },
  "$defs": {
    "credentialStatus": {
      "description": "The only field a user interface colors. Never REAL or FAKE.",
      "enum": ["absent", "present_invalid", "valid_untrusted", "valid_trusted", "error"]
    },
    "sourceCategory": {
      "enum": ["ai-generated", "ai-composite", "ai-enhanced", "algorithmic", "software", "camera", "unknown"]
    },
    "metawatchField": {
      "enum": [
        "AIPromptInformation", "AIPromptWriterName", "AISystemUsed", "AISystemVersionUsed",
        "AltTextAccessibility", "CaptionDescription", "Copyright", "Creator", "CreditLine",
        "DataMining", "DateCreated", "DigitalSourceType", "ExtendedDescriptionAccessibility",
        "Genre", "Keywords", "LicensorName", "LicensorURL", "LocationCreated", "LocationShown",
        "ObjectName", "Source", "UsageTerms", "WebStatement"
      ]
    },
    "validationEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "explanation_key": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
